# Copy this file to .env and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins, or * for any (fine for local dev)
CORS_ORIGINS=*

# --- Defaults ---
DEFAULT_STT_MODEL=whisper
DEFAULT_TTS_MODEL=mms
DEFAULT_LANGUAGE=ml

# --- Models (Hugging Face IDs) ---
WHISPER_MODEL_ID=openai/whisper-small
INDICCONFORMER_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# ctc or rnnt
INDICCONFORMER_DECODER=ctc
MMS_TTS_MODEL_ID=facebook/mms-tts-mal

# Needed only if a model repo is gated (e.g. IndicConformer may require accepting terms)
HF_TOKEN=

# Load these models at startup instead of on first request (comma-separated, e.g. whisper,mms)
PRELOAD_MODELS=

# --- Files / limits ---
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=25
TTS_MAX_CHARS=1000
