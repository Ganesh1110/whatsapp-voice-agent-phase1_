# Copy this file to .env and adjust as needed.

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins, or * for any (fine for local dev)
CORS_ORIGINS=*

# --- Defaults ---
DEFAULT_STT_MODEL=whisper
DEFAULT_TTS_MODEL=indic-parler-tts
DEFAULT_LLM_MODEL=remote
DEFAULT_LANGUAGE=ml

# --- Models (Hugging Face IDs) ---
# Whisper large-v3 on your RTX 5060 Ti 16GB (local path or HF hub id).
WHISPER_MODEL_ID=openai/whisper-large-v3
INDICCONFORMER_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# ctc or rnnt
INDICCONFORMER_DECODER=ctc
MMS_TTS_MODEL_ID=facebook/mms-tts-mal
# Indic Parler-TTS for Malayalam.
INDIC_PARLER_TTS_MODEL_ID=ai4bharat/indic-parler-tts
HF_HUB_OFFLINE=1

# --- Remote LLM (AWS GPU server: google/gemma-4-E4B-it) ---
# Endpoint serving gemma (Ollama-compatible /api/chat, vLLM/TGI OpenAI-compatible, etc.)
LLM_HOST=https://YOUR_AWS_GPU_SERVER
LLM_MODEL=google/gemma-4-E4B-it
# api style: ollama (POST /api/chat) or openai (POST /v1/chat/completions)
LLM_API_STYLE=ollama
LLM_REQUEST_TIMEOUT=300

# --- Ollama (local LLM, kept as fallback) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Asterisk ARI (voice bridge) ---
ARI_SAMPLE_RATE_IN=8000
ARI_SAMPLE_RATE_OUT=8000
ARI_MAX_BUFFER_SECONDS=6.0
ARI_MIN_UTTERANCE_SECONDS=0.8
ARI_LANGUAGE=ml

# ARI Stasis application (asterisk/ari_bridge.py connects here)
ARI_HOST=localhost
ARI_PORT=8088
ARI_APP=voice-bridge
ARI_USER=voice-bridge
ARI_PASSWORD=bridge-secret

# FastAPI media endpoint that Asterisk externalMedia connects to
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
FASTAPI_PATH=/ari/stream

# Needed only if a model repo is gated (e.g. IndicConformer may require accepting terms)
HF_TOKEN=

# Load these models at startup instead of on first request (comma-separated, e.g. whisper,mms,ollama)
PRELOAD_MODELS=

# --- Files / limits ---
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=25
TTS_MAX_CHARS=1000
